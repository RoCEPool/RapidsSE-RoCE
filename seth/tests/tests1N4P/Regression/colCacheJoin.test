// after a truncate of the joined table no row joins
truncate ${testName2}_orders;
success

select count(*)
  from ${testName2}_customer, ${testName2}_orders
 where c_custkey = o_custkey and c_mktsegment = 'BUILDING';
rows: (0)

select c_count, count(*) as custdist
  from (select c_custkey, count(o_orderkey)
