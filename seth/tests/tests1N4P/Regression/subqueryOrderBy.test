// sub-query in the HAVING: it is injected into the aggregation and the keys do move
select l_orderkey, sum(l_quantity) as q
  from ${testName2}_lineitem
 group by l_orderkey
having sum(l_quantity) > (select max(l_quantity) * 5.2 from ${testName2}_lineitem)
 order by q desc, l_orderkey;
ordered rows:
  (6882, 303)
  (8516, 271)
  (2567, 266)

drop table ${testName2}_orders;
success
drop table ${testName2}_lineitem;
success
