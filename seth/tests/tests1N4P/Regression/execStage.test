select o_orderpriority, count(*), sum(l_extendedprice * (1 - l_discount)) from ${testName2}_orders, ${testName2}_lineitem where o_orderkey = l_orderkey and o_orderdate < date '1995-01-01' group by o_orderpriority order by o_orderpriority;
