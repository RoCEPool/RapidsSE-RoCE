      ('2-HIGH', 512, 12368150.5170)
      ('3-MEDIUM', 548, 13168644.5753)
      ('4-NOT SPECIFIED', 610, 15001676.2631)
      ('5-LOW', 548, 13178292.9081)

/optimiser_off_col_cache_join
