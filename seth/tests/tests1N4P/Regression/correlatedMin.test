// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  With a filter on the outer query
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select n_name, s_name, s_acctbal
  from ${testName2}_supplier, ${testName2}_nation
 where s_nationkey = n_nationkey
   and n_regionkey = 3
   and s_acctbal = (select min(s2.s_acctbal)
                      from ${testName2}_supplier s2
                     where n_nationkey = s2.s_nationkey)
 order by n_name, s_name;
ordered rows:
  ('FRANCE', 'Supplier#000001845', -971.99)
  ('GERMANY', 'Supplier#000001664', -954.24)
  ('ROMANIA', 'Supplier#000001008', -858.86)
  ('RUSSIA', 'Supplier#000000065', -963.79)
