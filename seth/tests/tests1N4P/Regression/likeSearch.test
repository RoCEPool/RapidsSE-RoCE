rows: (8226)

select count(*) from ${testName2}_lineitem where l_comment not like '%a%';
rows: (1774)

select count(*) from ${testName2}_lineitem where l_comment like '%%';
rows: (10000)

select count(*) from ${testName2}_lineitem where l_comment not like '%%';
rows: (0)

