/*----------------------------------------------------------------------------*/
/* joinPipeline.test -- project and GROUP BY in the stage of an index join    */
/*----------------------------------------------------------------------------*/

// A project behind an index join (and its filters) runs in the stage of the
// join, and so does a GROUP BY behind that project (Card_Stage.cpp), as DuckDB
// keeps the join probe, projection and aggregation in one pipeline. Not for
// an outer join, nor for a project that reads one table column twice (two
// aliases of one table). These queries check the inner-join cases; the
// outer join is covered by TPC-H Q13 in tests/tpch_sf1_correctness.
// The rows were computed with SQLite from DATA/TPCH/lineitem10k.csv,
// supplier_2k.tbl and nation.tbl.

create table ${testName2}_lineitem (
  L_ORDERKEY      INTEGER       NOT NULL,
  L_PARTKEY       INTEGER       NOT NULL,
  L_SUPPKEY       INTEGER       NOT NULL,
  L_LINENUMBER    INTEGER       NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    CHAR(1)       NOT NULL,
  L_LINESTATUS    CHAR(1)       NOT NULL,
  L_SHIPDATE      DATE          NOT NULL,
  L_COMMITDATE    DATE          NOT NULL,
  L_RECEIPTDATE   DATE          NOT NULL,
  L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
  L_SHIPMODE      CHAR(10)      NOT NULL,
  L_COMMENT       VARCHAR(44)   NOT NULL
);
success
create index ${testName2}_IxL_ORDERKEY on ${testName2}_lineitem (L_ORDERKEY);
affected: 0
load ${testName2}_lineitem "../DATA/TPCH/lineitem10k.csv";
success

create table ${testName2}_nation (
  N_NATIONKEY  INTEGER      NOT NULL,
  N_NAME       CHAR(25)     NOT NULL,
  N_REGIONKEY  INTEGER      NOT NULL,
  N_COMMENT    VARCHAR(152)
);
success
create index ${testName2}_IxN_NATIONKEY on ${testName2}_nation (N_NATIONKEY);
affected: 0
create index ${testName2}_IxN_REGIONKEY on ${testName2}_nation (N_REGIONKEY);
affected: 0
load ${testName2}_nation "../DATA/TPCH/nation.tbl" <field_delimiter> = "|";
success
create table ${testName2}_supplier (
  S_SUPPKEY    INTEGER       NOT NULL,
  S_NAME       CHAR(25)      NOT NULL,
  S_ADDRESS    VARCHAR(40)   NOT NULL,
  S_NATIONKEY  INTEGER       NOT NULL,
  S_PHONE      CHAR(15)      NOT NULL,
  S_ACCTBAL    DECIMAL(15,2) NOT NULL,
  S_COMMENT    VARCHAR(101)  NOT NULL
);
success
create index ${testName2}_IxS_SUPPKEY on ${testName2}_supplier (S_SUPPKEY);
affected: 0
load ${testName2}_supplier "../DATA/TPCH/supplier_2k.tbl" <field_delimiter> = "|";
success

create index ${testName2}_IxL_SUPPKEY on ${testName2}_lineitem (L_SUPPKEY);
affected: 0

// join, filter, project and GROUP BY in one stage
select s_nationkey, count(*), sum(l_quantity) from ${testName2}_supplier, ${testName2}_lineitem
 where s_suppkey = l_suppkey and l_quantity > 40 group by s_nationkey order by s_nationkey limit 5;
ordered rows:
  (0, 12, 573.00)
  (1, 17, 790.00)
  (2, 17, 755.00)
  (3, 8, 377.00)
  (4, 15, 684.00)

// two aliases of one table
select n1.n_name, n2.n_name, count(*) from ${testName2}_supplier, ${testName2}_nation n1, ${testName2}_nation n2
 where s_nationkey = n1.n_nationkey and n2.n_nationkey = n1.n_regionkey and s_acctbal > 9000
 group by n1.n_name, n2.n_name order by n1.n_name, n2.n_name limit 4;
ordered rows:
  ('ALGERIA', 'ALGERIA', 9)
  ('ARGENTINA', 'ARGENTINA', 4)
  ('BRAZIL', 'ARGENTINA', 6)
  ('CANADA', 'ARGENTINA', 8)

// join and project, no GROUP BY
select s_name, l_orderkey from ${testName2}_supplier, ${testName2}_lineitem
 where s_suppkey = l_suppkey and l_linenumber = 7 and s_nationkey = 3 order by l_orderkey limit 3;
ordered rows:
  ('Supplier#000001501', 3205)

// string comparisons in the aggregates: the GROUP BY allocates its strings
// after those of the projected row (TPC-H Q12 counted wrong when they overlapped)
select s_nationkey,
       sum(case when l_shipmode = 'MAIL' or l_shipmode = 'SHIP' then 1 else 0 end),
       sum(case when l_shipmode <> 'MAIL' and l_shipmode <> 'SHIP' then 1 else 0 end)
  from ${testName2}_supplier, ${testName2}_lineitem
 where s_suppkey = l_suppkey and l_quantity > 40 group by s_nationkey order by s_nationkey limit 3;
ordered rows:
  (0, 1, 11)
  (1, 5, 12)
  (2, 5, 12)

// the same behind a table scan
select l_linestatus,
       sum(case when l_shipmode = 'MAIL' or l_shipmode = 'SHIP' then 1 else 0 end),
       sum(case when l_shipmode <> 'MAIL' and l_shipmode <> 'SHIP' then 1 else 0 end)
  from ${testName2}_lineitem where l_quantity > 40 group by l_linestatus order by l_linestatus;
ordered rows:
  ('F', 265, 717)
  ('O', 301, 744)
