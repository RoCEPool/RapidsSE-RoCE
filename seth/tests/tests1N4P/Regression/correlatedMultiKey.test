// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Keys in the other order, outer column first, no <project> in the sub-query
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName2}_partsupp
 where ps_availqty > (select sum(l_quantity)
                        from ${testName2}_lineitem
                       where ps_suppkey = l_suppkey
                         and ps_partkey = l_partkey
                         and l_shipdate >= date '1995-01-01');
rows:
  (54)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Two keys, one of them a string, on a self-join
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select l1.l_shipmode, l1.l_linenumber, l1.l_orderkey
  from ${testName2}_lineitem l1
 where l1.l_extendedprice = (select max(l2.l_extendedprice)
                               from ${testName2}_lineitem l2
                              where l2.l_shipmode = l1.l_shipmode
                                and l2.l_linenumber = l1.l_linenumber)
 order by l1.l_shipmode, l1.l_linenumber, l1.l_orderkey;
