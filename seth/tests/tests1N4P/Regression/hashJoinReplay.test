/*----------------------------------------------------------------------------*/
/* hashJoinReplay.test -- outer, semi and anti joins as hash joins            */
/*----------------------------------------------------------------------------*/

// An outer, semi or anti join on one integer key that is the first operator
// of its stage stores the arriving rows and, at the end of the input, replays
// them in arrival order against the entries of their keys, collected by one
// scan of the joined table's key column (IndexTree.cpp HashJoin, bRange), or
// against the index. A table partition below 500,000 rows is joined through
// its index as before; /hash_join_replay_small lifts that for these tables.
// Each query runs as an index join (no tag), replaying against the scan,
// with /hash_join_walk, replaying against the index
// (/optimiser_off_hash_join_scan), and with /optimiser_off_hash_join_replay.
// The expected rows were computed from TPCH/SF_0001 in Python.

create table ${testName2}_orders (
  O_ORDERKEY      INTEGER       NOT NULL,
  O_CUSTKEY       INTEGER       NOT NULL,
  O_ORDERSTATUS   CHAR(1)       NOT NULL,
  O_TOTALPRICE    DECIMAL(15,2) NOT NULL,
  O_ORDERDATE     DATE          NOT NULL,
  O_ORDERPRIORITY CHAR(15)      NOT NULL,
  O_CLERK         CHAR(15)      NOT NULL,
  O_SHIPPRIORITY  INTEGER       NOT NULL,
  O_COMMENT       VARCHAR(79)   NOT NULL
);
success
create index ${testName2}_IxO_ORDERKEY on ${testName2}_orders (O_ORDERKEY);
affected: 0
load ${testName2}_orders "../TPCH/SF_0001/orders.tbl" <field_delimiter> = "|";
success

create table ${testName2}_lineitem (
   L_ORDERKEY      INTEGER       NOT NULL,
   L_PARTKEY       INTEGER       NOT NULL,
   L_SUPPKEY       INTEGER       NOT NULL,
   L_LINENUMBER    INTEGER       NOT NULL,
   L_QUANTITY      DECIMAL(15,2) NOT NULL,
   L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
   L_DISCOUNT      DECIMAL(15,2) NOT NULL,
   L_TAX           DECIMAL(15,2) NOT NULL,
   L_RETURNFLAG    CHAR(1)       NOT NULL,
   L_LINESTATUS    CHAR(1)       NOT NULL,
   L_SHIPDATE      DATE          NOT NULL,
   L_COMMITDATE    DATE          NOT NULL,
   L_RECEIPTDATE   DATE          NOT NULL,
   L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
   L_SHIPMODE      CHAR(10)      NOT NULL,
   L_COMMENT       VARCHAR(44)   NOT NULL
);
success
create index ${testName2}_IxL_ORDERKEY on ${testName2}_lineitem (L_ORDERKEY);
affected: 0
load ${testName2}_lineitem "../TPCH/SF_0001/lineitem.tbl" <field_delimiter> = "|";
success

select count(*), sum(l1.l_quantity) from ${testName2}_lineitem l1 where l1.l_receiptdate > l1.l_commitdate and exists (select * from ${testName2}_lineitem l2 where l2.l_orderkey = l1.l_orderkey and l2.l_suppkey <> l1.l_suppkey);
rows: (3570, 90822.00)

/hash_join_replay_small
select count(*), sum(l1.l_quantity) from ${testName2}_lineitem l1 where l1.l_receiptdate > l1.l_commitdate and exists (select * from ${testName2}_lineitem l2 where l2.l_orderkey = l1.l_orderkey and l2.l_suppkey <> l1.l_suppkey);
rows: (3570, 90822.00)

/hash_join_replay_small
/hash_join_walk
select count(*), sum(l1.l_quantity) from ${testName2}_lineitem l1 where l1.l_receiptdate > l1.l_commitdate and exists (select * from ${testName2}_lineitem l2 where l2.l_orderkey = l1.l_orderkey and l2.l_suppkey <> l1.l_suppkey);
rows: (3570, 90822.00)

/hash_join_replay_small
/optimiser_off_hash_join_scan
