// keys of 1, 2, 7, 8 and 9 bytes (NULL keys left out)
select s, count(*), sum(x) from ${testName2}_keys where s is not null group by s;
rows:
  ('a', 2, 5)
  ('abcdefg', 1, 6)
  ('abcdefgh', 2, 12)
  ('abcdefghi', 1, 10)
  ('bb', 2, 11)

select s, count(*), sum(x) from ${testName2}_keys where s is not null group by s;
rows:
  ('a', 2, 5)
  ('abcdefg', 1, 6)
  ('abcdefgh', 2, 12)
  ('abcdefghi', 1, 10)
  ('bb', 2, 11)

/optimiser_off_gby_key_cache
select s, count(*), sum(x) from ${testName2}_keys where s is not null group by s;
rows:
