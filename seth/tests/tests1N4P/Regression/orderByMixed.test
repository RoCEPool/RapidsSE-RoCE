/*----------------------------------------------------------------------------*/
/* orderByMixed.test -- ORDER BY with three or more keys and mixed directions */
/*----------------------------------------------------------------------------*/

// A sort key with a descending column is compared element by element.
// EntWrk::ayEachElm did not move its cursor, so the third and later elements
// were all read at the position of the second one: rows equal on the first
// two keys came out in an arbitrary order. All-ascending keys are compared
// as one block of memory and were not affected, nor were two-key sorts.
// The expected order was computed from DATA/TPCH/lineitem1k.csv independently
// of RapidsSE; every ORDER BY below is a total order on the selected rows.

create table ${testName2}_lineitem (
  L_ORDERKEY      INTEGER       NOT NULL,
  L_PARTKEY       INTEGER       NOT NULL,
  L_SUPPKEY       INTEGER       NOT NULL,
  L_LINENUMBER    INTEGER       NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    CHAR(1)       NOT NULL,
  L_LINESTATUS    CHAR(1)       NOT NULL,
  L_SHIPDATE      DATE          NOT NULL,
  L_COMMITDATE    DATE          NOT NULL,
  L_RECEIPTDATE   DATE          NOT NULL,
  L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
  L_SHIPMODE      CHAR(10)      NOT NULL,
  L_COMMENT       VARCHAR(44)   NOT NULL
);
success

load ${testName2}_lineitem "../DATA/TPCH/lineitem1k.csv";
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  DESC, ASC, ASC: integer keys
