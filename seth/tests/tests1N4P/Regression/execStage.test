rows: (3570, 90822.00)

select count(*), sum(l1.l_quantity) from ${testName2}_lineitem l1 where l1.l_receiptdate > l1.l_commitdate and exists (select * from ${testName2}_lineitem l2 where l2.l_orderkey = l1.l_orderkey and l2.l_suppkey <> l1.l_suppkey) and not exists (select * from ${testName2}_lineitem l3 where l3.l_orderkey = l1.l_orderkey and l3.l_suppkey <> l1.l_suppkey and l3.l_receiptdate > l3.l_commitdate);
