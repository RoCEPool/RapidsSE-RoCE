/*----------------------------------------------------------------------------*/
/* aggregateDistinct.test -- COUNT(DISTINCT x), SUM(DISTINCT x)               */
/*----------------------------------------------------------------------------*/

// DISTINCT aggregates were accepted by the SQL compiler and then failed in the
// execution engine, which has no DISTINCT aggregate ("EC_NONE", TPC-H Q16).
// They are now planned as two aggregations:
//   select g, count(distinct e) from t group by g
//   = select g, count(e) from (select g, e from t group by g, e) group by g
// The lower one is partitioned and merged like any GROUP BY; the upper one
// runs on the merged groups.
// Not implemented, and reported as such: DISTINCT aggregates together with
// other aggregates, DISTINCT aggregates over different expressions.
// AVG(DISTINCT x) is in avgOverAggregate.test.
// The expected rows were computed from DATA/TPCH/orders10k.csv and
// lineitem10k.csv independently of RapidsSE.

create table ${testName2}_orders (
  O_ORDERKEY      INTEGER       NOT NULL,
  O_CUSTKEY       INTEGER       NOT NULL,
  O_ORDERSTATUS   CHAR(1)       NOT NULL,
  O_TOTALPRICE    DECIMAL(15,2) NOT NULL,
  O_ORDERDATE     DATE          NOT NULL,
  O_ORDERPRIORITY CHAR(15)      NOT NULL,
  O_CLERK         CHAR(15)      NOT NULL,
  O_SHIPPRIORITY  INTEGER       NOT NULL,
  O_COMMENT       VARCHAR(79)   NOT NULL
);
success
create index ${testName2}_IxO_ORDERKEY on ${testName2}_orders (O_ORDERKEY);
affected: 0
load ${testName2}_orders "../DATA/TPCH/orders10k.csv";
success

create table ${testName2}_lineitem (
  L_ORDERKEY      INTEGER       NOT NULL,
  L_PARTKEY       INTEGER       NOT NULL,
  L_SUPPKEY       INTEGER       NOT NULL,
  L_LINENUMBER    INTEGER       NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    CHAR(1)       NOT NULL,
  L_LINESTATUS    CHAR(1)       NOT NULL,
  L_SHIPDATE      DATE          NOT NULL,
  L_COMMITDATE    DATE          NOT NULL,
  L_RECEIPTDATE   DATE          NOT NULL,
  L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
  L_SHIPMODE      CHAR(10)      NOT NULL,
  L_COMMENT       VARCHAR(44)   NOT NULL
);
success
create index ${testName2}_IxL_ORDERKEY on ${testName2}_lineitem (L_ORDERKEY);
affected: 0
load ${testName2}_lineitem "../DATA/TPCH/lineitem10k.csv";
success

// without GROUP BY
select count(distinct l_suppkey) from ${testName2}_lineitem;
rows:
  (6379)

// GROUP BY; COUNT and SUM over the same expression
select l_returnflag, count(distinct l_linenumber) as c, sum(distinct l_linenumber)
  from ${testName2}_lineitem
 group by l_returnflag
 order by l_returnflag;
ordered rows:
  ('A', 7, 28)
  ('N', 7, 28)
  ('R', 7, 28)

// over a join, ordered by the aggregate (the Q16 shape)
select o_orderstatus, count(distinct l_suppkey) as c
  from ${testName2}_orders, ${testName2}_lineitem
 where o_orderkey = l_orderkey
 group by o_orderstatus
 order by c desc, o_orderstatus;
ordered rows:
  ('O', 3942)
  ('F', 3794)
  ('P', 304)

// in the HAVING as well
select l_shipmode, count(distinct l_partkey) as c
  from ${testName2}_lineitem
 group by l_shipmode
having count(distinct l_partkey) > 1415
 order by c desc, l_shipmode;
ordered rows:
  ('TRUCK', 1454)
  ('REG AIR', 1441)
  ('RAIL', 1426)

// inside an expression
select count(distinct l_shipmode) * 2 from ${testName2}_lineitem;
rows:
  (14)

// over a grouping column
select l_linenumber, count(distinct l_linenumber)
  from ${testName2}_lineitem
 where l_linenumber < 4
 group by l_linenumber
 order by l_linenumber;
ordered rows:
  (1, 1)
  (2, 1)
  (3, 1)

// MIN and MAX do not depend on DISTINCT and may stand next to other aggregates
select l_returnflag, max(distinct l_quantity), count(*)
  from ${testName2}_lineitem
 group by l_returnflag
 order by l_returnflag;
ordered rows:
  ('A', 50, 2434)
  ('N', 50, 5151)
  ('R', 50, 2415)

// not implemented
select count(distinct l_suppkey), count(*) from ${testName2}_lineitem;
failure contains: 'not yet implemented'

select count(distinct l_suppkey), count(distinct l_partkey) from ${testName2}_lineitem;
failure contains: 'not yet implemented'

drop table ${testName2}_orders;
success
drop table ${testName2}_lineitem;
success
