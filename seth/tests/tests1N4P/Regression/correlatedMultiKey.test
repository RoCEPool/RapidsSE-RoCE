// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Three keys
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName2}_lineitem l1
 where l1.l_quantity = (select min(l2.l_quantity)
                          from ${testName2}_lineitem l2
                         where l2.l_returnflag = l1.l_returnflag
                           and l2.l_linestatus = l1.l_linestatus
                           and l2.l_shipmode = l1.l_shipmode);
rows:
  (208)

drop table ${testName2}_lineitem;
success
drop table ${testName2}_partsupp;
success
